# LLM Provider — supported: groq | openai | anthropic | gemini
# Install matching package in requirements.txt, set key below, restart backend.
LLM_PROVIDER=groq
LLM_API_KEY=your-api-key-here
# LLM_MODEL=openai/gpt-oss-120b   # optional: override the default model for the chosen provider
#
# Default models per provider:
#   groq      → openai/gpt-oss-120b        (free: https://console.groq.com/keys)
#   openai    → gpt-4o-mini                (paid: https://platform.openai.com/api-keys)
#   anthropic → claude-3-5-haiku-20241022  (paid: https://console.anthropic.com/)
#   gemini    → gemini-2.5-flash           (free: https://aistudio.google.com/apikey)
#
# Package to install per provider:
#   groq      → groq
#   openai    → openai
#   anthropic → anthropic
#   gemini    → google-generativeai

# Database (local dev)
DATABASE_URL=postgresql://costdetective:password@localhost:5432/costdetective

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# AWS Credentials (or use ~/.aws/credentials / IAM roles)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# Minimum IAM permissions (read-only):
# ec2:Describe*, rds:Describe*, s3:ListAllMyBuckets, s3:GetBucket*,
# elasticloadbalancing:Describe*, lambda:ListFunctions, lambda:GetFunction,
# cloudwatch:GetMetricStatistics, sts:GetCallerIdentity

# App
CORS_ORIGIN=http://localhost:5173
